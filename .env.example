# Shopify app (pull with: cd shopify-app && shopify app env pull --env-file ../.env)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,write_products,read_orders,write_orders,read_customers,write_customers,read_inventory,write_inventory,read_locations,read_discounts,write_discounts,read_draft_orders,write_draft_orders,read_reports,read_themes,write_themes,read_online_store_pages,write_online_store_pages,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders,read_publications,write_publications
SHOPIFY_API_VERSION=2027-01
# Default shop for the install link and seed script
SHOPIFY_SHOP=your-store.myshopify.com

APP_URL=http://localhost:3000
DATABASE_URL=postgres://oasis:oasis@localhost:5433/oasis
# 32-byte hex keys: openssl rand -hex 32
ENCRYPTION_KEY=
SESSION_SECRET=

# Model as provider:model-id (anthropic | openai | google)
LLM_MODEL=openai:gpt-5.4-mini
# Used automatically when LLM_MODEL is overloaded (5xx/429) or doesn't respond within 20s
LLM_FALLBACK_MODEL=google:gemini-3-flash-preview
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Meta Ads (optional): app for "Connect with Facebook". Redirect URI: <APP_URL>/api/integrations/meta/callback
META_APP_ID=
META_APP_SECRET=
# Bearer token for GET /api/cron when deployed with an external scheduler
CRON_SECRET=
# Set to off to disable the in-app scheduler
OASIS_SCHEDULER=
